# Copy to .env for Docker Compose. Never commit .env or real secrets.
PORT=8080
CONFIG_PATH=config/experiments.json
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=generate-a-random-local-password
ADMIN_TOKEN=generate-a-long-random-admin-bearer-token
# For go run -tags pgx ./cmd/api (not required in Docker Compose):
# DATABASE_URL=postgres://experiment:password@localhost:5432/experiments?sslmode=disable

# Per API-instance token bucket limits; defaults shown below.
# Behind a reverse proxy, these use the proxy peer IP. Also configure edge limits.
ASSIGN_RATE_RPS=1500
ASSIGN_RATE_BURST=3000
TRACK_RATE_RPS=60
TRACK_RATE_BURST=120
ADMIN_RATE_RPS=10
ADMIN_RATE_BURST=20
